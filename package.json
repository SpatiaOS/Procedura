{
  "name": "procedura",
  "version": "0.1.0",
  "description": "Procedura \u2014 an agent that writes 3D shapes as parametric programs, part by part.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/install-deps.sh",
    "setup:mcp": "bash scripts/install-mcp.sh",
    "mcp": "python3 mcp/server.py",
    "test:mcp": "python3 -m unittest discover -s mcp/tests -p 'test_*.py' && bun test mcp/tests",
    "typecheck": "tsc --noEmit",
    "procedura": "bun run scripts/procedura.ts",
    "paint": "bun run scripts/paint.ts",
    "motion": "bun run scripts/motion.ts",
    "batch": "bun run scripts/batch.ts",
    "results": "bun run scripts/results-server.ts"
  },
  "dependencies": {
    "@harness/template": "file:./vendor/harness",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
